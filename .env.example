# ── Port ────────────────────────────────────────────────────────────────
# Port → (…) menu → Credentials. Use an admin's client ID/secret.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
# EU (app.port.io): https://api.port.io   US (app.us.port.io): https://api.us.port.io
PORT_API_URL=https://api.port.io
PORT_APP_URL=https://app.port.io

# Public HTTPS address of a tunnel that forwards to the orchestrator on
# localhost:4000. Get one by running, in its own terminal:
#   cloudflared tunnel --url http://localhost:4000     (or: ngrok http 4000)
# and copying the https URL it prints. Base URL only: no trailing slash and
# no /port/webhook (setup adds that). Example:
#   PUBLIC_WEBHOOK_URL=https://quiet-river-1234.trycloudflare.com
PUBLIC_WEBHOOK_URL=

# Your email: shown as the service's on-call in the catalog.
DEMO_ONCALL_EMAIL=you@example.com

# ── Agents ──────────────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty (or set AGENT_MODE=mock) to run the agents with
# deterministic logic instead of an LLM. Handy for rehearsals.
OPENAI_API_KEY=
# Any OpenAI model with function calling that your key can access.
OPENAI_MODEL=gpt-5.2
AGENT_MODE=llm

# ── Demo app & orchestrator ─────────────────────────────────────────────
APP_URL=http://localhost:3001
APP_PORT=3001
APP_ADMIN_TOKEN=demo-admin-token
ORCHESTRATOR_PORT=4000
SERVICE_NAME=payments-api

# Alert fires when, over the last 30 seconds, error rate > ALERT_ERROR_RATE
# or p99 latency > ALERT_P99_MS, for two checks in a row.
ALERT_ERROR_RATE=0.05
ALERT_P99_MS=800
# Seconds to wait after the rollback before the Verify Agent checks recovery.
VERIFY_WAIT_SECONDS=30
# Set to false only while debugging; keeps Port webhook signatures checked.
VERIFY_PORT_SIGNATURE=true

# Load generator
LOAD_CONCURRENCY=20

# ── Control room (npm run demo → http://localhost:5050) ─────────────────
# UI_PORT=5050
# Who can ship from the control room, as "Display name:handle" pairs.
# DEMO_PEOPLE=Alex Kim:alex.kim,Pavan:pavan
